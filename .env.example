# Copy to .env (cp .env.example .env) and fill in YOUR values. .env is gitignored; never commit it.
CODICIL_QDRANT_URL=
CODICIL_QDRANT_API_KEY=
CODICIL_QDRANT_COLLECTION=codicil
# Optional LLM phrasing (leave empty for extractive answers)
CODICIL_LLM_BASE_URL=
CODICIL_LLM_API_KEY=
CODICIL_LLM_MODEL=
CODICIL_LLM_TIMEOUT_S=12
CODICIL_LLM_REASONING_EFFORT=
CODICIL_LLM_SEND_TEMPERATURE=true
